---
//Footer.astro
// No podemos importar directaemente los icons en un archivo astro por lo que tenemos que crear un archivo .tsx para poder usarlos
// en un archivo astro
import { LinkedinIcon } from "@/components/ui/iconsFooter.tsx";
import { FacebookIcon } from "@/components/ui/iconsFooter.tsx";
import { HandMetalIcon } from "@/components/ui/iconsFooter.tsx";
import { TwitterIcon } from "@/components/ui/iconsFooter.tsx";
import { InstagramIcon } from "@/components/ui/iconsFooter.tsx";


// Importa el componente Button
import { Button } from "../ui/button";

---



<footer class="bg-black text-white pt-16">
    <div class="container flex flex-col sm:flex-row items-center sm:items-start gap-16">
        <section class="h-full w-fit flex flex-col justify-start itemes-star py-12">
            <div class="flex items-center gap-4">
                <span class="font-header text-4xl"> Choya.Tech </span>
            </div>

            <h6 class="mt-6 font-bold">Siguenos:</h6>
            <div class="flex gap-2 mt-2">
                <Button
                size="icon"
                variant="ghost"
                className="bg-white/25 p-2 rounded-xl"
                aria-label="LinkedIn"
                >
                <LinkedinIcon />
                </Button>

                <Button
                size="icon"
                variant="ghost"
                className="bg-white/25 p-2 rounded-xl"
                aria-label="Facebook">
                <FacebookIcon />
                </Button>

                <Button
                size="icon"
                variant="ghost"
                className="bg-white/25 p-2 rounded-xl"
                aria-label="Instragram">
                <InstagramIcon />
                </Button>

                <Button
                size="icon"
                variant="ghost"
                className="bg-white/25 p-2 rounded-xl"
                aria-label="Twitter">
                <TwitterIcon />
                </Button>

                <Button
                size="icon"
                variant="ghost"
                className="bg-white/25 p-2 rounded-xl"
                aria-label="HandMetal">
                <HandMetalIcon />
                </Button>
            </div>
        </section>

        <section class="flex-1 grid grid-cols-1 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-4 py-11" >
            <div class="mb-12">
                <h4 class="text-xl font-bold">Acerca de</h4>
                <ul class="md:mt-12">
                    <li>
                        <Button variant="link"  className="px-0 text-white/65 text-md">
                            Compañia
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Precios
                        </Button>
                    </li>
                </ul>
            </div>
            <div class="mb-12">
                <h4 class="text-xl font-bold">Casos</h4>
                <ul class="md:mt-12">
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Educación
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            E-Commerce
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Gestión
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Negocios Locales
                        </Button>
                    </li>
                </ul>
            </div>

            <div class="mb-12">
                <h4 class="text-xl font-bold">Recursos</h4>
                <ul class="md:mt-12">
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Blog
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md" >
                            Centro de Ayuda
                        </Button>
                    </li>
                </ul>
            </div>

            <div class="mb-12">
                <h4 class="text-xl font-bold" >Términos y Condiciones</h4>
                <ul class="md:mt-12">
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Términos y Condiciones
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Políticas de Accesibilidad
                        </Button>
                    </li>
                    <li>
                        <Button variant="link" className="px-0 text-white/65 text-md">
                            Políticas de Privacidad
                        </Button>
                    </li>
                </ul>
            </div>
        </section>
    </div>
    <div class="container">
        <p class="container text-white/50" >
            Copyright © 2024, Choya Tech. Todos los derechos reservados.
        </p>
    </div>
</footer>