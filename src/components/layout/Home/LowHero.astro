---
import { Button } from "@/components/ui/button";
---

<main class="container my-20 flex h-[calc(100vh-22rem)]">
    <div class="w-1/2 hidden lg:flex items-center">
        <img src="/miroodles_2.png" alt="Imagen de Presentación" class="" />
    </div>
    <div class="flex-1 flex flex-col items-center lg:items-start justify-center gap-6 md:gap-12">
        <h2 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-center lg:text-start">
            ¿Listo para Llevar Tu Negocio al Siguiente Nivel con Choya Tech?
        </h2>
        <Button>
            <a href="mailto:contactochoyatech@gmail.com" class="flex">
                ¡Contáctanos Hoy!
            </a>
        </Button>

    </div>

</main>